# Ledgr API gateway — environment
APP_ENV=staging
PORT=3000

# Base URL of the Supabase-hosted API this gateway proxies to, e.g.
#   https://<project-ref>.supabase.co/functions/v1/api
TARGET_URL=

# Sentry DSN for backend error capture (optional; anonymised)
SENTRY_DSN=

# Comma-separated list of allowed CORS origins (browser frontend).
# Browser origins are denied unless explicitly listed.
ALLOWED_ORIGIN=http://localhost:5173

# Required when APP_ENV=production. Shared, atomic rate-limit store for every
# gateway instance (Redis/Upstash-compatible connection URL).
REDIS_URL=redis://localhost:6379
