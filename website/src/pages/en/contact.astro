---
// Contact (/en/contact/) — form + direct channels.
// TODO: decide form backend (Formspree/Web3Forms/self-hosted endpoint) —
// see STRUCTURE.md §11. The form below posts nowhere yet.
import SiteLayout from '../../layouts/SiteLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { SITE } from '../../data/site';
import { t } from '../../i18n';

const locale = 'en' as const;
---

<SiteLayout
  locale={locale}
  path="contact"
  title={t(locale, 'pageTitles.contact')}
  description="Get in touch with the Ledgr team — sales, support and partnerships for Malawian SMEs."
>
  <section class="bg-brand-950">
    <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-400">Contact</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl">Talk to us</h1>
      <p class="mt-4 max-w-xl text-lg text-brand-100">
        Questions, demos, partnerships or feedback — we reply fast.
      </p>
    </div>
  </section>

  <section class="mx-auto grid w-full max-w-6xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-5">
    <div class="space-y-4 lg:col-span-2">
      <SectionHeading align="left" eyebrow="Direct" title="Other ways to reach us" />
      <ul class="space-y-3 text-sm text-navy-600">
        <li>
          <span class="font-semibold text-navy-900">Sales & partnerships:</span>{' '}
          <a href={`mailto:${SITE.salesEmail}`} class="text-brand-600 hover:text-brand-700">{SITE.salesEmail}</a>
        </li>
        <li>
          <span class="font-semibold text-navy-900">Support:</span>{' '}
          <a href={`mailto:${SITE.supportEmail}`} class="text-brand-600 hover:text-brand-700">{SITE.supportEmail}</a>
        </li>
        <li class="pt-2">
          <span class="font-semibold text-navy-900">Already a user?</span> Use the
          in-app AI support agent — it answers most questions instantly and can
          escalate to a human.
        </li>
        <!-- TODO: add phone/WhatsApp number once confirmed -->
      </ul>
    </div>

    <div class="lg:col-span-3">
      <form class="space-y-4 rounded-2xl border border-navy-200 bg-card-bg p-6 shadow-soft" action="#" method="post">
        <!-- TODO: wire action to form backend -->
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-sm font-medium text-navy-900">
            Name
            <input type="text" name="name" required class="mt-1.5 w-full rounded-lg border border-navy-200 px-3.5 py-2.5 text-sm focus:border-brand-500 focus:outline-none" />
          </label>
          <label class="block text-sm font-medium text-navy-900">
            Email
            <input type="email" name="email" required class="mt-1.5 w-full rounded-lg border border-navy-200 px-3.5 py-2.5 text-sm focus:border-brand-500 focus:outline-none" />
          </label>
        </div>
        <label class="block text-sm font-medium text-navy-900">
          Subject
          <select name="subject" class="mt-1.5 w-full rounded-lg border border-navy-200 px-3.5 py-2.5 text-sm focus:border-brand-500 focus:outline-none">
            <option>General question</option>
            <option>Sales / demo</option>
            <option>Partnership (bank / MFI)</option>
            <option>Support</option>
            <option>Feedback</option>
          </select>
        </label>
        <label class="block text-sm font-medium text-navy-900">
          Message
          <textarea name="message" rows="5" required class="mt-1.5 w-full rounded-lg border border-navy-200 px-3.5 py-2.5 text-sm focus:border-brand-500 focus:outline-none"></textarea>
        </label>
        <button type="submit" class="rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-soft transition-colors hover:bg-brand-700">
          Send message
        </button>
      </form>
    </div>
  </section>
</SiteLayout>
