---
// Blog index (/en/blog/) — posts from the content collection, filtered to the
// current locale. See also /rss.xml.
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../../i18n';

const locale = 'ny' as const;

const posts = (await getCollection('blog'))
  .filter((p) => p.data.locale === locale && !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = new Intl.DateTimeFormat('en-MW', { year: 'numeric', month: 'long', day: 'numeric' });
---
<!-- TODO: Chichewa translation of body copy pending — chrome (nav/footer/CTAs) is translated. -->

<SiteLayout
  locale={locale}
  path="blog"
  title={t(locale, 'pageTitles.blog')}
  description="Practical guides for Malawian SMEs — PAYE, VAT, MRA filings, bookkeeping and more from the Ledgr team."
>
  <section class="bg-brand-950">
    <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-400">Blog</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl">
        Resources for Malawian businesses
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">
        Tax, bookkeeping and business finance — written for Malawi.
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6">
    {
      posts.length === 0 ? (
        <p class="text-navy-600">No posts yet — check back soon.</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            posts.map((post) => (
              <article class="flex flex-col rounded-2xl border border-navy-200 bg-card-bg p-6 shadow-soft transition-shadow hover:shadow-card-hover">
                <p class="text-xs font-medium text-navy-600">{fmt.format(post.data.pubDate)}</p>
                <h2 class="mt-2 text-lg font-semibold leading-snug text-navy-900">
                  <a href={getRelativeLocaleUrl(locale, `blog/${post.id.split('/').pop()}`)} class="hover:text-brand-700">
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-navy-600">{post.data.description}</p>
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {post.data.tags.map((tag) => (
                    <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-700">{tag}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      )
    }
  </section>
</SiteLayout>
