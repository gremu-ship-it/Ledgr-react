---
// SectionHeading — consistent eyebrow + title + subtitle for sections.
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, subtitle, align = 'center' } = Astro.props;
const alignCls = align === 'center' ? 'mx-auto text-center' : 'text-left';
---

<div class={`max-w-2xl ${alignCls}`}>
  {eyebrow && (
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">{eyebrow}</p>
  )}
  <h2 class="mt-2 text-3xl font-bold tracking-tight text-navy-900 sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-lg leading-relaxed text-navy-600">{subtitle}</p>}
</div>
