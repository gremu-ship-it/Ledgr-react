---
// TestimonialCard — placeholder-ready quote card.
interface Props {
  quote: string;
  name: string;
  business: string;
}

const { quote, name, business } = Astro.props;
---

<figure class="flex h-full flex-col rounded-2xl border border-navy-200 bg-card-bg p-6 shadow-soft">
  <blockquote class="flex-1 text-sm leading-relaxed text-navy-600">“{quote}”</blockquote>
  <figcaption class="mt-4 flex items-center gap-3">
    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700" aria-hidden="true">
      {name.charAt(0)}
    </span>
    <div>
      <p class="text-sm font-semibold text-navy-900">{name}</p>
      <p class="text-xs text-navy-600">{business}</p>
    </div>
  </figcaption>
</figure>
