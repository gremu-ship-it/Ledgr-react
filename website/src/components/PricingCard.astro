---
// PricingCard — one plan tier. Data comes from src/data/pricing.ts.
// Supports the monthly/annual billing toggle: both prices are rendered as
// data attributes and swapped by the tiny script on the pricing page.
import { formatMWK, type Plan } from '../data/pricing';
import { dict } from '../i18n';
import type { Locale } from '../data/site';

interface Props {
  plan: Plan;
  locale?: Locale;
}

const { plan } = Astro.props;
const locale: Locale = Astro.props.locale ?? ((Astro.currentLocale as Locale) ?? 'en');
const d = dict(locale).pricing;

const monthly = formatMWK(plan.priceMWK);
const annual = plan.annualDiscount > 0
  ? formatMWK(Math.round(plan.priceMWK * (1 - plan.annualDiscount / 100)))
  : monthly;
const saveLabel = d.save.replace('{pct}', String(plan.annualDiscount));
---

<div
  data-plan-card
  data-monthly={monthly}
  data-annual={annual}
  class:list={[
    'relative flex flex-col rounded-2xl border bg-card-bg p-6 shadow-soft',
    plan.popular ? 'border-brand-500 ring-2 ring-brand-500/30' : 'border-navy-200',
  ]}
>
  {plan.popular && (
    <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand-600 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
      {d.mostPopular}
    </span>
  )}

  <h3 class="text-lg font-semibold text-navy-900">{plan.name}</h3>
  <p class="mt-3 flex items-baseline gap-1">
    <span data-price class="text-3xl font-bold tracking-tight text-navy-900">{monthly}</span>
    <span class="text-sm text-navy-600">{d.perMonth}</span>
  </p>
  {plan.annualDiscount > 0 && (
    <p data-annual-note hidden class="mt-1 text-xs font-medium text-brand-700">
      {d.saveWithAnnual.replace('{pct}', String(plan.annualDiscount))}
    </p>
  )}

  <ul class="mt-5 flex-1 space-y-2.5">
    {
      plan.features.map((f) => (
        <li class="flex items-start gap-2 text-sm text-navy-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span>{f}</span>
        </li>
      ))
    }
  </ul>
</div>
