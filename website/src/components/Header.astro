---
// Header — sticky top nav with locale-aware links, language switcher and CTAs.
// Mobile menu is a zero-JS <details> disclosure.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE, type Locale } from '../data/site';
import { t, dict } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? ((Astro.currentLocale as Locale) ?? 'en');
const d = dict(locale).nav;
const url = (path: string) => getRelativeLocaleUrl(locale, path);

const links = [
  { href: url('features'), label: d.features },
  { href: url('pricing'), label: d.pricing },
  { href: url('partners'), label: d.partners },
  { href: url('developers'), label: d.developers },
  { href: url('help'), label: d.help },
  { href: url('blog'), label: d.blog },
];
---

<header class="sticky top-0 z-40 border-b border-navy-200/70 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <!-- Brand -->
    <a href={url('')} class="flex items-center gap-2.5" aria-label={SITE.name}>
      <img src="/favicon.svg" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
      <span class="text-xl font-bold tracking-tight text-navy-900">
        Ledgr<span class="text-brand-600">.</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} class="text-sm font-medium text-navy-600 transition-colors hover:text-brand-700">
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher locale={locale} />
      <a
        href={`${SITE.appUrl}/login`}
        class="hidden text-sm font-medium text-navy-600 hover:text-brand-700 sm:inline-flex"
      >
        {d.signIn}
      </a>
      <a
        href={`${SITE.appUrl}/register`}
        class="inline-flex items-center rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-soft transition-colors hover:bg-brand-700"
      >
        {d.getStarted}
      </a>

      <!-- Mobile menu (zero-JS) -->
      <details class="relative lg:hidden">
        <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md text-navy-900 hover:bg-navy-200/50">
          <span class="sr-only">{t(locale, 'common.openMenu')}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-56 rounded-xl border border-navy-200 bg-white p-2 shadow-card">
          {
            links.map((l) => (
              <a href={l.href} class="block rounded-lg px-3 py-2 text-sm font-medium text-navy-900 hover:bg-brand-50 hover:text-brand-700">
                {l.label}
              </a>
            ))
          }
          <a href={`${SITE.appUrl}/login`} class="block rounded-lg px-3 py-2 text-sm font-medium text-navy-600 hover:bg-brand-50 hover:text-brand-700">
            {d.signIn}
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
