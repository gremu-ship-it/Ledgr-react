---
// FeatureCard — icon + title + body for module grids.
interface Props {
  title: string;
  body: string;
  /** Inline SVG markup (stroke="currentColor" recommended). */
  icon: string;
}

const { title, body, icon } = Astro.props;
---

<div class="rounded-2xl border border-navy-200 bg-card-bg p-6 shadow-soft transition-shadow hover:shadow-card-hover">
  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-700" set:html={icon} />
  <h3 class="mt-4 text-lg font-semibold text-navy-900">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-navy-600">{body}</p>
</div>
