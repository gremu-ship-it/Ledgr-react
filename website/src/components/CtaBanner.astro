---
// CtaBanner — brand band used before the footer on marketing pages.
import { SITE, type Locale } from '../data/site';
import { dict } from '../i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? ((Astro.currentLocale as Locale) ?? 'en');
const d = dict(locale).cta;
---

<section class="bg-brand-700" aria-labelledby="cta-heading">
  <div class="mx-auto flex w-full max-w-6xl flex-col items-center gap-6 px-4 py-16 text-center sm:px-6">
    <h2 id="cta-heading" class="max-w-2xl text-3xl font-bold tracking-tight text-white sm:text-4xl">
      {d.title}
    </h2>
    <p class="max-w-xl text-brand-100">{d.subtitle}</p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href={`${SITE.appUrl}/register`}
        class="rounded-lg bg-white px-6 py-3 text-sm font-semibold text-brand-700 shadow-soft transition-colors hover:bg-brand-50"
      >
        {d.button}
      </a>
      <a
        href={`mailto:${SITE.salesEmail}`}
        class="rounded-lg border border-brand-300 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-800"
      >
        {d.secondary}
      </a>
    </div>
  </div>
</section>
