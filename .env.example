# ================================================
# Ledgr Environment Variables
# Copy this file to .env and fill in the real values
# ================================================

# Arena AI Agent (for AI Insights)
VITE_ARENA_AGENT_URL=https://api.arena.ai/v1/agents/ledgr-financial-advisor/invoke
VITE_ARENA_API_KEY=your_arena_api_key_here

# Supabase Edge Function secrets (configure with `supabase secrets set`, never VITE_)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=invoices@yourdomain.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PayChangu (subscription payments) — Supabase Edge Function secrets only,
# never exposed to the browser. Get these from https://dashboard.paychangu.com
# Settings > API & Webhooks. Set the webhook URL there to:
#   https://<project-ref>.supabase.co/functions/v1/paychangu-webhook
PAYCHANGU_SECRET_KEY=your_paychangu_secret_key_here
PAYCHANGU_WEBHOOK_SECRET=your_paychangu_webhook_secret_here
# Public base URL of the deployed app (used to build the post-payment
# return_url so PayChangu can redirect the owner back into Settings > Billing).
APP_URL=https://app.yourdomain.com
# Shared secret for the cron-invoked Edge Functions: expire-subscriptions,
# send-renewal-reminders, generate-partner-invoices and generate-vat-returns.
# Each rejects any request whose `x-cron-secret` header does not match, so the
# pg_cron schedules must send it (see the schedule_* migrations).
CRON_SECRET=a_long_random_string_here

# CORS allowlist for Edge Functions (comma-separated, no trailing slash).
# Falls back to APP_URL when unset, and to '*' when neither is configured.
# Set this in production to stop arbitrary origins reading function responses.
# localhost on any port is always permitted for local development.
ALLOWED_ORIGINS=https://app.yourdomain.com

# Supabase Configuration
SUPABASE_PROJECT_REF=your_project_ref_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: Supabase Client Keys (used by the frontend)
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key_here