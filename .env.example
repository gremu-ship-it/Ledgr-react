# ================================================
# Ledgr Environment Variables
# Copy this file to .env and fill in the real values
# ================================================

# AI Insights ("Ledgr AI" chat) — served by the `ai-insights` Supabase Edge
# Function (Anthropic). There is nothing to configure in the browser: the
# client calls supabase.functions.invoke('ai-insights') and the AI provider key
# (ANTHROPIC_API_KEY, below) stays server-side.

# Support Agent (Supabase Edge Function) — set with `supabase secrets set`,
# never expose these to the browser (no VITE_ prefix). Provider: Anthropic
# (ANTHROPIC_API_KEY below), shared with other Ledgr edge functions.
# See SUPPORT_AGENT.md.
# Support email surfaced to users when the agent escalates to a human.
SUPPORT_EMAIL=support@ledgr.app

# ── Ledgr AI assistant (src/lib/ai/*) ───────────────────────────────────────
# BOTH assistants work with ZERO configuration: with nothing set below, the
# deterministic rules engine answers everything offline and for free.
#
# Set VITE_AI_CHAT_URL to route open-ended questions through the `ai-chat`
# Edge Function, which holds the provider key server-side. This is the ONLY
# AI variable that may carry a VITE_ prefix — it is a URL, never a key.
# VITE_AI_CHAT_URL=https://<project-ref>.supabase.co/functions/v1/ai-chat
#
# Edge Function secrets for ai-chat (`supabase secrets set AI_PROVIDER=groq AI_API_KEY=...`):
#   AI_PROVIDER  groq (default) | gemini | openrouter | anthropic
#   AI_API_KEY   provider key; falls back to ANTHROPIC_API_KEY when AI_PROVIDER=anthropic
#   AI_MODEL     optional model override (defaults: llama-3.1-8b-instant,
#                gemini-1.5-flash, meta-llama/llama-3.1-8b-instruct:free,
#                claude-3-5-haiku-latest)
AI_PROVIDER=groq
AI_API_KEY=your_groq_api_key_here

# Supabase Edge Function secrets (configure with `supabase secrets set`, never VITE_)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=invoices@yourdomain.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Invoice tracking pixel HMAC secret — used to sign/verify the open-tracking
# pixel URLs embedded in sent invoices. Must match between send-invoice and
# invoice-open Edge Functions. Falls back to CRON_SECRET if not set.
INVOICE_TRACKING_SECRET=a_long_random_string_for_invoice_tracking

# CORS origin allowlist — comma-separated list of origins permitted to call
# Edge Functions. If unset, falls back to reflecting the APP_URL / Supabase
# project domain. Example: https://app.ledgr.app,https://admin.ledgr.app
ALLOWED_ORIGINS=https://app.yourdomain.com

# PayChangu (subscription payments) — Supabase Edge Function secrets only,
# never exposed to the browser. Get these from https://dashboard.paychangu.com
# Settings > API & Webhooks. Set the webhook URL there to:
#   https://<project-ref>.supabase.co/functions/v1/paychangu-webhook
PAYCHANGU_SECRET_KEY=your_paychangu_secret_key_here
PAYCHANGU_WEBHOOK_SECRET=your_paychangu_webhook_secret_here
# Public base URL of the deployed app (used to build the post-payment
# return_url so PayChangu can redirect the owner back into Settings > Billing).
APP_URL=https://app.yourdomain.com
# Shared secret for scheduled Edge Functions (expire-subscriptions,
# generate-vat-returns, process-invoice-automation, …).
# process-invoice-automation also accepts INVOICE_CRON_SECRET; if that is
# unset it falls back to CRON_SECRET. Deploy currently sets only CRON_SECRET.
CRON_SECRET=a_long_random_string_here

# Supabase Configuration
SUPABASE_PROJECT_REF=your_project_ref_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: Supabase Client Keys (used by the frontend)
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key_here