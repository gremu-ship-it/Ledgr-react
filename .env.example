# ================================================
# Ledgr Environment Variables
# Copy this file to .env and fill in the real values
# ================================================

# Arena AI Agent (for AI Insights)
VITE_ARENA_AGENT_URL=https://api.arena.ai/v1/agents/ledgr-financial-advisor/invoke
VITE_ARENA_API_KEY=your_arena_api_key_here

# Support Agent (Supabase Edge Function) — set with `supabase secrets set`,
# never expose these to the browser (no VITE_ prefix).
# Optional: point the support agent at a dedicated Arena agent. If left unset,
# the edge function falls back to Anthropic (ANTHROPIC_API_KEY), which is already
# configured for other Ledgr edge functions. See SUPPORT_AGENT.md.
SUPPORT_AGENT_ARENA_URL=https://api.arena.ai/v1/agents/ledgr-support-agent/invoke
SUPPORT_AGENT_ARENA_KEY=your_arena_support_api_key_here
# Support email surfaced to users when the agent escalates to a human.
SUPPORT_EMAIL=support@ledgr.app

# Supabase Edge Function secrets (configure with `supabase secrets set`, never VITE_)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=invoices@yourdomain.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PayChangu (subscription payments) — Supabase Edge Function secrets only,
# never exposed to the browser. Get these from https://dashboard.paychangu.com
# Settings > API & Webhooks. Set the webhook URL there to:
#   https://<project-ref>.supabase.co/functions/v1/paychangu-webhook
PAYCHANGU_SECRET_KEY=your_paychangu_secret_key_here
PAYCHANGU_WEBHOOK_SECRET=your_paychangu_webhook_secret_here
# Public base URL of the deployed app (used to build the post-payment
# return_url so PayChangu can redirect the owner back into Settings > Billing).
APP_URL=https://app.yourdomain.com
# Shared secret for the expire-subscriptions cron job (see
# supabase/migrations/20260726000003_schedule_expire_subscriptions.sql).
CRON_SECRET=a_long_random_string_here

# Supabase Configuration
SUPABASE_PROJECT_REF=your_project_ref_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: Supabase Client Keys (used by the frontend)
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key_here